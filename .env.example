# AMPLIFY Environment Configuration Template
# For production/cloud deployment with Supabase:
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: In the absence of cloud credentials, AMPLIFY runs fully autonomously
# in offline-first Local Repository mode using AsyncStorage.
EXPO_PUBLIC_USE_DEMO_PERSISTENCE=true
